{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automergeType": "pr",
  "timezone": "Europe/Budapest",
  "recreateWhen": "never",
  "enabledManagers": [
    "dockerfile",
    "custom.regex",
    "github-actions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "^VERSION$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\\s*$"
      ],
      "depNameTemplate": "ghcr.io/l1p0-m/renovate-cron",
      "packageNameTemplate": "renovate/renovate",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["renovate/renovate"],
      "groupName": "Renovate",
      "commitMessageTopic": "Renovate: {{{depName}}}",
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["* 8-12 * * 1"],
      "automerge": true
    }
  ]
}